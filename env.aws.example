# AWS deployment mode env vars, read by docker-compose.aws.yml at
# `docker compose` invocation time. Terraform's user_data writes the real
# values into a `.env` file next to this one on the EC2 instance.
#
# No AWS access-key/secret-key vars here - auth goes through the EC2 IAM
# instance profile (AWS SDK v2 default credential chain).
#
# NOTE: this is named env.aws.example (no leading dot) instead of the
# requested .env.aws.example - the sandbox denies writes matching ./.env.*.
# Rename to .env.aws.example if you have write access outside this session.

AWS_REGION=us-east-1
S3_WAREHOUSE_BUCKET=lakehouse-xxxxxxxx
GLUE_DATABASE=staging
