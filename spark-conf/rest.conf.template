# dev: Hudi tables on MinIO. No catalog-service quirk to work around with
# Hudi -- plain Spark session catalog + CREATE TABLE ... USING hudi LOCATION
# '...' is enough.
spark.scheduler.mode=FAIR
spark.sql.extensions=org.apache.spark.sql.hudi.HoodieSparkSessionExtension
spark.serializer=org.apache.spark.serializer.KryoSerializer

# MinIO via Hadoop's S3A filesystem (Hudi has no bundled S3 client of its
# own, unlike Iceberg's S3FileIO -- hadoop-aws jar added in the Dockerfile).
spark.hadoop.fs.s3a.endpoint=http://minio:9000
spark.hadoop.fs.s3a.access.key=minioadmin
spark.hadoop.fs.s3a.secret.key=minioadmin
spark.hadoop.fs.s3a.path.style.access=true
spark.hadoop.fs.s3a.impl=org.apache.hadoop.fs.s3a.S3AFileSystem
spark.hadoop.fs.s3a.connection.ssl.enabled=false

spark.sql.session.timeZone=UTC

# Native Spark Prometheus metrics (built into Spark 3.5.3, no exporter needed).
# JvmSource isn't registered by default -- without it, the Grafana "JVM heap
# used" panel has no metric to query (source, not sink, so it's a separate line).
spark.ui.prometheus.enabled=true
spark.metrics.conf.*.source.jvm.class=org.apache.spark.metrics.source.JvmSource
spark.metrics.conf.*.sink.prometheusServlet.class=org.apache.spark.metrics.sink.PrometheusServlet
spark.metrics.conf.*.sink.prometheusServlet.path=/metrics/prometheus
spark.metrics.conf.master.sink.prometheusServlet.path=/metrics/master/prometheus
spark.metrics.conf.worker.sink.prometheusServlet.path=/metrics/worker/prometheus
spark.metrics.conf.applications.sink.prometheusServlet.path=/metrics/applications/prometheus
spark.sql.streaming.metricsEnabled=true
